# Mock offline por defecto. Para el modo real recomendado, usar LLM_PROVIDER=groq.
LLM_PROVIDER=mock
APP_PORT=8000

# Desarrollo sin Docker. Compose utiliza la ruta interna y un volumen persistente.
# CALLS_DB_PATH=data/private/calls.sqlite3

# Groq: usar una cuenta Free y verificar sus límites. Solo se consulta al seleccionar groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Anthropic opcional (puede consumir créditos); solo se consulta al seleccionar haiku.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
